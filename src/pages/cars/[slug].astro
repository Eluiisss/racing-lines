---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import BrandMark from "../../components/BrandMark.astro";
import Drawing from "../../components/Drawing.astro";
import EngineBay from "../../components/EngineBay.astro";
import {
  brandOf,
  commitHash,
  commitMessage,
  getArchive,
  PROPULSION_LABELS,
  spec,
  type Car,
} from "../../lib/archive";

export const getStaticPaths = (async () => {
  const cars = await getArchive();
  return cars.map((car, i) => ({
    params: { slug: car.data.slug },
    props: { car, prev: cars[i - 1], next: cars[i + 1], all: cars },
  }));
}) satisfies GetStaticPaths;

interface Props {
  car: Car;
  prev?: Car;
  next?: Car;
  all: Car[];
}

const { car, prev, next, all } = Astro.props;
const { data } = car;
const brand = brandOf(data);
const [main, ...more] = data.drawings;

const groups = [
  { title: "Powertrain", rows: data.specifications.powertrain },
  { title: "Chassis", rows: data.specifications.chassis },
  { title: "Dimensions", rows: data.specifications.dimensions },
].filter((g) => g.rows.length > 0);

// Related: explicit relatedCars first, otherwise same brand, otherwise nearest in time.
const bySlug = new Map(all.map((c) => [c.data.slug, c]));
let related = data.relatedCars.map((s) => bySlug.get(s)).filter((c): c is Car => Boolean(c));
if (related.length === 0) {
  related = all
    .filter((c) => c.data.slug !== data.slug)
    .sort(
      (a, b) =>
        Number(b.data.make === data.make) - Number(a.data.make === data.make) ||
        Math.abs(a.data.year - data.year) - Math.abs(b.data.year - data.year),
    )
    .slice(0, 3);
}
---

<Base
  title={`${data.make} ${data.model} (${data.year})`}
  description={data.introduction ?? `Technical sheet and original drawing of the ${data.year} ${data.make} ${data.model}.`}
>
  <article class="sheet wrap">
    <nav class="crumbs label" aria-label="Breadcrumb">
      <a class="link" href="/#timeline">Commit tree</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{commitHash(data.slug)}</span>
    </nav>

    <header class="sheet__head">
      <div>
        <p class="label sheet__commit">
          <span class="hash">{commitHash(data.slug)}</span>
          {commitMessage(data)} · tag {data.year}
        </p>
        <h1>
          <span class="sheet__make">{data.make}</span>
          {data.model}
        </h1>
        <p class="sheet__sub label">
          {[data.designation, data.country, data.propulsion && PROPULSION_LABELS[data.propulsion]]
            .filter(Boolean)
            .join(" · ")}
        </p>
      </div>
      <BrandMark brand={brand} size="lg" />
    </header>

    {data.introduction && <p class="sheet__intro">{data.introduction}</p>}

    {
      main && (
        <section class="gallery" aria-label="Drawings">
          <div class="gallery__main ticks">
            <Drawing
              src={main.src}
              alt={main.label}
              length={spec(data, "Length")}
              eager
              transitionName={`drawing-${data.slug}`}
            />
            {main.caption && <p class="gallery__caption">{main.caption}</p>}
          </div>
          {more.length > 0 && (
            <ul class="gallery__more">
              {more.map((d) => (
                <li>
                  <Drawing src={d.src} alt={d.label} />
                </li>
              ))}
            </ul>
          )}
        </section>
      )
    }

    {
      data.cutaway && (
        <EngineBay
          engine={data.cutaway.engine}
          body={data.cutaway.body}
          title={data.cutaway.title}
          carName={`${data.make} ${data.model}`}
        />
      )
    }

    <div class="sheet__body">
      {
        groups.length > 0 && (
          <section aria-labelledby="specs-title">
            <h2 id="specs-title" class="section-title">Technical sheet</h2>
            <div class="spec-groups">
              {groups.map((g) => (
                <table>
                  <caption class="label">{g.title}</caption>
                  <tbody>
                    {g.rows.map((r) => (
                      <tr>
                        <th scope="row">{r.label}</th>
                        <td>{r.value}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              ))}
            </div>
          </section>
        )
      }

      <section aria-labelledby="history-title">
        <h2 id="history-title" class="section-title">History</h2>
        {
          data.history.format === "highlights" ? (
            <ol class="history">
              {data.history.entries.map((e) => (
                <li>
                  {e.year && <span class="label history__year">{e.year}</span>}
                  <h3>{e.title}</h3>
                  <p>{e.detail}</p>
                </li>
              ))}
            </ol>
          ) : (
            <div class="history">
              {data.history.entries.map((e) => (
                <blockquote>
                  <p>“{e.text}”</p>
                  <footer class="label">
                    — <a class="link" href={e.sourceUrl} rel="noopener">{e.attribution}</a>
                  </footer>
                </blockquote>
              ))}
            </div>
          )
        }

        {
          data.sources.length > 0 && (
            <>
              <h2 class="section-title sources-title">Sources</h2>
              <ul class="sources">
                {data.sources.map((s) => (
                  <li>
                    <a class="link" href={s.url} rel="noopener">
                      {s.title}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </section>
    </div>

    {
      related.length > 0 && (
        <section class="related" aria-labelledby="related-title">
          <h2 id="related-title" class="section-title">Related vehicles</h2>
          <ul>
            {related.map(({ data: r }) => {
              const d = r.drawings[0];
              return (
                <li>
                  <a class="related__card" href={`/cars/${r.slug}/`}>
                    {d && <Drawing src={d.src} alt="" />}
                    <span class="label">{r.year} · {commitHash(r.slug)}</span>
                    <span class="related__name">
                      {r.make} {r.model}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    <nav class="pager" aria-label="Timeline">
      {
        prev ? (
          <a class="btn btn--ghost" href={`/cars/${prev.data.slug}/`} rel="prev">
            <span class="arrow">←</span> {prev.data.year} {prev.data.model}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="btn btn--ghost" href={`/cars/${next.data.slug}/`} rel="next">
            {next.data.year} {next.data.model} <span class="arrow">→</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .sheet {
    padding-top: clamp(20px, 3vw, 32px);
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .sheet__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding-block: clamp(16px, 3vw, 32px);
    border-bottom: 1px solid var(--ink);
  }
  .sheet__commit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .hash {
    padding: 1px 6px;
    border: 1px solid var(--line-50);
    color: var(--ink);
    font-weight: 600;
  }
  h1 {
    margin-top: 16px;
    font-size: var(--step-3);
    text-transform: uppercase;
  }
  .sheet__make {
    display: block;
    font-size: 0.4em;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--line);
  }
  .sheet__sub {
    margin-top: 12px;
  }
  .sheet__intro {
    max-width: 62ch;
    margin-top: 24px;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .gallery {
    display: grid;
    gap: 16px;
    margin-top: clamp(24px, 4vw, 48px);
  }
  .gallery__main {
    padding: clamp(12px, 2vw, 24px);
    background: var(--paper);
    border: 1px solid var(--line-50);
  }
  .gallery__caption {
    margin-top: 12px;
    color: var(--line);
    font-size: var(--step--1);
  }
  .gallery__more {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sheet__body {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 64px);
    margin-top: clamp(40px, 6vw, 72px);
  }
  .section-title {
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--ink);
    font-size: var(--step-1);
    text-transform: uppercase;
  }
  .spec-groups {
    display: grid;
    gap: 24px;
  }
  .spec-groups table {
    width: 100%;
    border-collapse: collapse;
    background: var(--paper);
    border: 1px solid var(--line-50);
    font-size: var(--step--1);
  }
  .spec-groups caption {
    padding: 8px 12px;
    text-align: left;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
  }
  .spec-groups th,
  .spec-groups td {
    padding: 10px 12px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line-30);
  }
  .spec-groups tr:last-child > * {
    border-bottom: 0;
  }
  .spec-groups th {
    width: 40%;
    font-weight: 500;
    color: var(--line);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .spec-groups td {
    font-weight: 600;
  }

  .history {
    position: relative;
    display: grid;
    gap: 24px;
    margin: 0;
    padding: 0 0 0 24px;
    list-style: none;
    border-left: 1.5px solid var(--ink);
  }
  .history li {
    position: relative;
  }
  .history li::before {
    content: "";
    position: absolute;
    left: -31px;
    top: 4px;
    width: 12px;
    height: 12px;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
  }
  .history h3 {
    margin-top: 4px;
    font-size: var(--step-0);
    text-transform: uppercase;
  }
  .history p {
    margin-top: 6px;
    color: var(--line);
  }
  blockquote {
    margin: 0;
  }
  .sources-title {
    margin-top: 40px;
  }
  .sources {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }
  .sources a {
    display: inline-block;
    padding-block: 6px;
  }

  .related {
    margin-top: clamp(48px, 7vw, 88px);
  }
  .related ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .related__card {
    display: grid;
    gap: 8px;
    height: 100%;
    padding: 16px;
    background: var(--paper);
    border: 1px solid var(--line-50);
    text-decoration: none;
    transition:
      transform 220ms var(--ease),
      border-color 220ms var(--ease);
  }
  .related__card:hover {
    transform: translateY(-2px);
    border-color: var(--ink);
  }
  .related__card:hover :global(.drawing__sheet img) {
    transform: scale(1.025);
  }
  .related__name {
    font-weight: 600;
    text-transform: uppercase;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(40px, 6vw, 64px);
  }

  @media (max-width: 860px) {
    .sheet__body {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .sheet__head {
      flex-direction: column-reverse;
    }
    .pager .btn {
      flex: 1 1 100%;
    }
  }
</style>
